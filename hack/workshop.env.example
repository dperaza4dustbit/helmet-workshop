# Copy to hack/workshop.env, customize, then:  set -a && source hack/workshop.env && set +a
#
# Used by container/build.sh and hack/setup-workshop.sh.

export WORKSHOP_IMAGE=quay.io/tsscdavp/helmet-workshop:dev
export HELMET_BRANCH=composable_bundles
export PLATFORM=linux/amd64

export PARTICIPANT_COUNT=20
export INSTRUCTOR_COUNT=2

# Only if Helmet is not ../helmet relative to helmet-workshop:
# export HELMET_DIR=/path/to/helmet

# Optional overrides:
# export COORDINATOR_IMAGE=quay.io/tsscdavp/helmet-workshop-coordinator:dev
# export HELMET_CHECKOUT=1
# export RESTRICT_SELF_PROVISIONER=1
# export RHBK_ADMIN_USER=your-keycloak-admin-username
